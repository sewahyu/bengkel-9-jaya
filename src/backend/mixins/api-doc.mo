mixin () {
  public query func getApiDoc() : async Text {
    let doc = "# API Backend — Jurusan Teknik Sepeda Motor SMKN 9 Malang\n\n"
      # "Dokumen ini menjelaskan API publik canister backend untuk aplikasi jurusan.\n"
      # "Seluruh data disimpan di dalam canister dan diakses melalui Candid.\n\n"
      # "## Tujuan\n\n"
      # "Backend menyediakan lima domain data:\n\n"
      # "- **Trainer** — inventaris unit Trainer (data unit lama) beserta jumlah total dan jumlah tersedia.\n"
      # "- **Alat** — inventaris Alat yang terpisah dari Trainer, dengan data sendiri.\n"
      # "- **Sparepart** — stok sparepart beserta mutasi stok (masuk/keluar).\n"
      # "- **Peminjaman** — pencatatan peminjaman dan pengembalian Trainer maupun Alat.\n"
      # "- **Jadwal UPJ** — jadwal tugas Unit Produksi dan Jasa (tampilan publik).\n"
      # "- **Keuangan** — nota/notulen keuangan (uang masuk dan keluar), hanya untuk admin.\n\n"
      # "Selain itu tersedia endpoint OQL (`schema` dan `execute`) untuk agen Data Intelligence,\n"
      # "serta endpoint login akun bawaan.\n\n"
      # "## Autentikasi dan Otorisasi\n\n"
      # "Aplikasi **tidak** memakai Internet Identity. Hanya ada **satu akun bawaan**:\n"
      # "username `admin` dan password `admin01`. Tidak ada pendaftaran, akun tambahan,\n"
      # "pemulihan kata sandi, atau penggantian kata sandi.\n\n"
      # "Pemanggil memulai sesi dengan `login(username, password)`. Bila kredensial benar,\n"
      # "backend menyimpan sesi untuk principal pemanggil dan mengembalikan `#ok(session)`;\n"
      # "bila salah, mengembalikan `#invalidCredentials` (bukan trap). Sesi bertahan di\n"
      # "state canister sampai `logout()` dipanggil, sehingga pemanggil tetap login setelah\n"
      # "halaman dimuat ulang. `getSession()` mengembalikan sesi pemanggil atau `null`.\n\n"
      # "Endpoint yang dijaga admin (seluruh operasi tulis, serta baca keuangan dan\n"
      # "peminjaman) memanggil `requireAdmin`: pemanggil yang belum login ditolak dengan\n"
      # "**trap** `Unauthorized: Hanya admin yang dapat melakukan tindakan ini` (atau pesan\n"
      # "khusus keuangan `Unauthorized: Data keuangan hanya dapat diakses admin yang sudah login`).\n"
      # "Endpoint baca publik (trainer, alat, sparepart, jadwal) tidak memerlukan login.\n\n"
      # "Endpoint autentikasi:\n\n"
      # "- `login(username, password) : LoginResult` — memulai sesi; `#ok(session)` atau `#invalidCredentials`.\n"
      # "- `logout() : ()` — mengakhiri sesi pemanggil.\n"
      # "- `getSession() : ?Session` — sesi pemanggil, atau `null` bila belum login.\n"
      # "- `isCallerAdmin() : Bool` — `true` bila pemanggil sudah login.\n\n"
      # "`Session` = `{ username : Text; loginAt : Int }`; `loginAt` adalah nanodetik sejak\n"
      # "epoch Unix (`Time.now()`).\n\n"
      # "## Endpoint per domain\n\n"
      # "### Trainer\n\n"
      # "- `listTrainer() : [Trainer]` — query publik, seluruh unit Trainer.\n"
      # "- `getTrainer(id) : ?Trainer` — query publik.\n"
      # "- `ringkasanTrainerPerKategori() : [RingkasanKategori]` — query publik, agregat per kategori.\n"
      # "- `addTrainer(nama, kategori, jumlahTotal, keterangan) : Trainer` — admin.\n"
      # "- `updateTrainer(id, nama, kategori, jumlahTotal, keterangan) : ?Trainer` — admin; `null` bila id tidak ada.\n"
      # "- `deleteTrainer(id) : Bool` — admin; `true` bila terhapus.\n\n"
      # "### Alat\n\n"
      # "- `listAlat() : [Alat]` — query publik, seluruh alat.\n"
      # "- `getAlat(id) : ?Alat` — query publik.\n"
      # "- `ringkasanAlatPerKategori() : [RingkasanKategori]` — query publik, agregat per kategori.\n"
      # "- `addAlat(nama, kategori, jumlahTotal, keterangan) : Alat` — admin.\n"
      # "- `updateAlat(id, nama, kategori, jumlahTotal, keterangan) : ?Alat` — admin; `null` bila id tidak ada.\n"
      # "- `deleteAlat(id) : Bool` — admin; `true` bila terhapus.\n\n"
      # "### Sparepart\n\n"
      # "- `listSparepart() : [Sparepart]` — query publik.\n"
      # "- `getSparepart(id) : ?Sparepart` — query publik.\n"
      # "- `listStokMenipis() : [Sparepart]` — query publik; stok pada atau di bawah ambang minimum.\n"
      # "- `listMutasiStok(sparepartId : ?Id) : [MutasiStok]` — query publik; `null` berarti semua sparepart.\n"
      # "- `addSparepart(nama, kode, kategori, jumlahStok, satuan, ambangMinimum) : Sparepart` — admin.\n"
      # "- `updateSparepart(id, nama, kode, kategori, satuan, ambangMinimum) : ?Sparepart` — admin.\n"
      # "- `deleteSparepart(id) : Bool` — admin.\n"
      # "- `catatMutasiStok(sparepartId, jenis, jumlah, keterangan) : ?MutasiStok` — admin; menyesuaikan stok.\n\n"
      # "### Peminjaman\n\n"
      # "- `listPeminjaman(jenis : ?JenisPeminjaman, status : ?StatusPeminjaman, cari : ?Text) : [Peminjaman]` — query admin; filter opsional.\n"
      # "- `getPeminjaman(id) : ?Peminjaman` — query admin.\n"
      # "- `catatPeminjamanTrainer(targetId, namaPeminjam, kelas, jumlah, tanggalPinjam, keperluan) : ?Peminjaman` — admin;\n"
      # "  jenis `\"trainer\"`, sumber `\"admin\"`, status `\"dipinjam\"`; mengurangi jumlah tersedia unit Trainer; `null` bila\n"
      # "  unit tidak ada atau stok tidak cukup.\n"
      # "- `catatPeminjamanAlat(targetId, namaPeminjam, kelas, jumlah, tanggalPinjam, keperluan) : ?Peminjaman` — admin;\n"
      # "  jenis `\"alat\"`, sumber `\"admin\"`, status `\"dipinjam\"`; mengurangi jumlah tersedia alat; `null` bila alat tidak ada\n"
      # "  atau stok tidak cukup.\n"
      # "- `ajukanPeminjamanAlat(targetId, namaPeminjam, kelas, jumlah, tanggalPinjam, keperluan, kontak) : ?Peminjaman` —\n"
      # "  **publik tanpa login**; jenis `\"alat\"`, sumber `\"pengunjung\"`, status `\"menunggu\"`; TIDAK mengubah stok alat;\n"
      # "  `null` bila alat tidak ada atau jumlah melebihi stok tersedia. **Hanya untuk Alat** — tidak ada jalur anonim untuk Trainer.\n"
      # "- `setujuiPeminjaman(id) : ?Peminjaman` — admin; `\"menunggu\"` -> `\"dipinjam\"` dan mengurangi stok pada inventaris\n"
      # "  yang sesuai (`jenis`); `null` bila id tidak ada, status bukan `\"menunggu\"`, atau stok tidak cukup.\n"
      # "- `tolakPeminjaman(id) : ?Peminjaman` — admin; `\"menunggu\"` -> `\"ditolak\"` tanpa mengubah stok;\n"
      # "  `null` bila id tidak ada atau status bukan `\"menunggu\"`.\n"
      # "- `catatPengembalian(id, tanggalKembali, kondisiKembali) : ?Peminjaman` — admin; mengembalikan stok pada inventaris\n"
      # "  yang sesuai (`jenis`).\n\n"
      # "`Peminjaman` memuat `jenis : Text` (`\"trainer\"` atau `\"alat\"`), `targetId : Nat` (id unit Trainer atau alat),\n"
      # "`namaTarget : Text`, `kontak : ?Text` (diisi pengunjung, `null` untuk input admin), dan `sumber : Text`\n"
      # "(`\"admin\"` atau `\"pengunjung\"`).\n\n"
      # "### Peminjaman Lab\n\n"
      # "- `listPeminjamanLab(lab : ?Lab) : [PeminjamanLab]` — query **publik**; `null` berarti semua lab.\n"
      # "- `getPeminjamanLab(id) : ?PeminjamanLab` — query **publik**.\n"
      # "- `ajukanPeminjamanLab(lab, namaPeminjam, kelas, kontak, tanggal, jamMulai, jamSelesai, keperluan) : ?PeminjamanLab` —\n"
      # "  **publik tanpa login**; status `\"menunggu\"`.\n"
      # "- `addPeminjamanLab(lab, namaPeminjam, kelas, kontak, tanggal, jamMulai, jamSelesai, keperluan, status) : ?PeminjamanLab` — admin.\n"
      # "- `updatePeminjamanLab(id, lab, namaPeminjam, kelas, kontak, tanggal, jamMulai, jamSelesai, keperluan, status) : ?PeminjamanLab` — admin.\n"
      # "- `deletePeminjamanLab(id) : Bool` — admin.\n\n"
      # "`Lab` = `Text` — `\"Lab 1 Chasis\"`, `\"Lab 2 Mesin\"`, atau `\"Lab 3 Kelistrikan\"`.\n"
      # "`StatusPeminjamanLab` = `Text` — `\"menunggu\"`, `\"disetujui\"`, atau `\"ditolak\"`.\n"
      # "`waktuDibuat` = `Int` — nanodetik sejak epoch Unix.\n\n"
      # "### Berita\n\n"
      # "- `listBerita() : [Berita]` — query **publik**; berita manual yang diisi admin.\n"
      # "- `getBerita(id) : ?Berita` — query **publik**.\n"
      # "- `getFeedUrl() : Text` — query **publik**; URL feed Instagram yang ditempel admin (kosong bila belum diatur).\n"
      # "- `addBerita(judul, ringkasan, gambarUrl, tautan, tanggal) : ?Berita` — admin; sumber `\"manual\"`.\n"
      # "- `updateBerita(id, judul, ringkasan, gambarUrl, tautan, tanggal) : ?Berita` — admin.\n"
      # "- `deleteBerita(id) : Bool` — admin.\n"
      # "- `setFeedUrl(url) : ()` — admin; menyimpan URL feed publik Instagram.\n\n"
      # "### Jadwal UPJ\n\n"
      # "- `listJadwal() : [JadwalUpj]` — query publik.\n"
      # "- `getJadwal(id) : ?JadwalUpj` — query publik.\n"
      # "- `addJadwal(hari, tanggal, namaSiswa, kelas, tugas) : JadwalUpj` — admin.\n"
      # "- `updateJadwal(id, hari, tanggal, namaSiswa, kelas, tugas) : ?JadwalUpj` — admin.\n"
      # "- `deleteJadwal(id) : Bool` — admin.\n\n"
      # "### Keuangan (hanya admin)\n\n"
      # "Seluruh endpoint keuangan memerlukan pemanggil yang sudah login.\n\n"
      # "- `listNota(jenis : ?JenisNota, dariTanggal : ?Text, sampaiTanggal : ?Text) : [Nota]` — query admin.\n"
      # "- `getNota(id) : ?Nota` — query admin.\n"
      # "- `ringkasanKeuangan() : RingkasanKeuangan` — query admin; total masuk, total keluar, saldo.\n"
      # "- `addNota(tanggal, keterangan, jenis, kategori, nominal) : Nota` — admin.\n"
      # "- `updateNota(id, tanggal, keterangan, jenis, kategori, nominal) : ?Nota` — admin.\n"
      # "- `deleteNota(id) : Bool` — admin.\n\n"
      # "## Tipe dan satuan\n\n"
      # "- `Id` = `Nat` — pengenal naik otomatis per domain, dimulai dari 1.\n"
      # "- `Timestamp` = `Int` — nanodetik sejak epoch Unix (dari `Time.now()`), dipakai pada `MutasiStok.waktu`.\n"
      # "- `tanggal`, `tanggalPinjam`, `tanggalKembali`, `dariTanggal`, `sampaiTanggal` = `Text` — format bebas\n"
      # "  yang ditentukan klien (disarankan `YYYY-MM-DD`); perbandingan rentang bersifat leksikografis.\n"
      # "- `nominal`, `jumlah`, `jumlahTotal`, `jumlahTersedia`, `jumlahStok`, `ambangMinimum` = `Nat` — bilangan\n"
      # "  bulat non-negatif; `nominal` dalam satuan rupiah tanpa pecahan.\n"
      # "- `jenis` = `Text` — `\"masuk\"` atau `\"keluar\"` (mutasi stok dan nota).\n"
      # "- `status` = `Text` — peminjaman: `\"menunggu\"`, `\"dipinjam\"`, `\"ditolak\"`, atau `\"dikembalikan\"`.\n"
      # "- `jenis` = `Text` — peminjaman: `\"trainer\"` (inventaris Trainer) atau `\"alat\"` (inventaris Alat).\n"
      # "- `tanggalKembali` dan `kondisiKembali` = `?Text` — `null` selama alat belum dikembalikan.\n"
      # "- `saldo` pada `RingkasanKeuangan` = `Int` — dapat bernilai negatif.\n\n"
      # "## Siklus hidup dan polling\n\n"
      # "- Operasi tulis bersifat sinkron: respons yang berhasil sudah mencerminkan perubahan state.\n"
      # "  Tidak ada status \"pending\", jadi tidak ada polling yang diperlukan.\n"
      # "- `catatPeminjamanTrainer`/`catatPeminjamanAlat` mengubah `jumlahTersedia` pada inventaris terkait;\n"
      # "  `catatPengembalian` mengembalikannya. Peminjaman berstatus `\"dipinjam\"` hingga `catatPengembalian` dipanggil.\n"
      # "- `ajukanPeminjamanAlat` dan `ajukanPeminjamanLab` membuat catatan berstatus `\"menunggu\"` tanpa\n"
      # "  mengubah stok; admin kemudian memanggil `setujuiPeminjaman`/`tolakPeminjaman` (alat) atau\n"
      # "  `updatePeminjamanLab` (lab) untuk mengubah status.\n"
      # "- `catatMutasiStok` dengan `\"masuk\"` menambah `jumlahStok`, `\"keluar\"` menguranginya.\n"
      # "- Untuk menyegarkan tampilan, panggil ulang endpoint `list*` / `get*` terkait.\n\n"
      # "## Keamanan pengulangan mutasi\n\n"
      # "- `login` idempoten terhadap kredensial: memanggilnya berulang dengan kredensial benar\n"
      # "  hanya memperbarui sesi pemanggil. `logout` idempoten.\n"
      # "- Operasi tulis **tidak idempoten**: memanggil `addTrainer`, `addAlat`, `addSparepart`, `addJadwal`, `addNota`,\n"
      # "  `catatPeminjamanTrainer`, `catatPeminjamanAlat`, `catatPengembalian`, `ajukanPeminjamanAlat`, `ajukanPeminjamanLab`,\n"
      # "  atau `catatMutasiStok` dua kali akan membuat dua catatan atau menyesuaikan stok dua kali.\n"
      # "  Kirim ulang hanya setelah memastikan panggilan sebelumnya gagal.\n"
      # "- `update*` dan `delete*` idempoten terhadap state akhir: mengulang `delete` mengembalikan `false`\n"
      # "  pada panggilan kedua, dan mengulang `update` dengan nilai sama tidak mengubah hasil.\n"
      # "- `delete*` bersifat destruktif dan tidak dapat dibatalkan.\n\n"
      # "## Kesalahan dan batasan\n\n"
      # "- `login` mengembalikan `#invalidCredentials` (bukan trap) untuk kredensial salah.\n"
      # "- Pelanggaran otorisasi menghasilkan **trap** (reject), bukan nilai `Result`. Pesan trap:\n"
      # "  `Unauthorized: Hanya admin yang dapat melakukan tindakan ini`, atau\n"
      # "  `Unauthorized: Data keuangan hanya dapat diakses admin yang sudah login`.\n"
      # "- `get*` dan `update*` mengembalikan `null` bila id tidak ditemukan; `delete*` mengembalikan `false`.\n"
      # "- `catatPeminjamanTrainer`, `catatPeminjamanAlat`, dan `ajukanPeminjamanAlat` mengembalikan `null` bila target\n"
      # "  tidak ada atau jumlah tersedia tidak mencukupi. `setujuiPeminjaman`/`tolakPeminjaman` mengembalikan `null` bila id tidak\n"
      # "  ada atau status bukan `\"menunggu\"`.\n"
      # "- `catatMutasiStok` mengembalikan `null` bila sparepart tidak ada atau `jenis` bukan\n"
      # "  `\"masuk\"`/`\"keluar\"`; mutasi `\"keluar\"` yang melebihi stok juga mengembalikan `null`.\n\n"
      # "## Catatan integrasi\n\n"
      # "- Endpoint `query` tidak mengubah state; jangan mengandalkannya untuk efek samping.\n"
      # "- Sesi disimpan per principal pemanggil. Bila frontend memakai agent anonim, seluruh\n"
      # "  pengguna berbagi satu principal, sehingga sesi bersifat global — sesuai untuk satu akun.\n"
      # "- Endpoint OQL (`schema`, `execute`) menyediakan akses baca terstruktur dengan otorisasi per tabel:\n"
      # "  `trainer`, `alat`, `sparepart`, `jadwalUpj`, `peminjamanLab`, dan `berita` bersifat publik;\n"
      # "  `mutasiStok`, `peminjaman`, dan `nota` hanya untuk controller.\n"
      # "- `getApiDoc()` mengembalikan dokumen statis ini dan tidak membaca state runtime.";
    doc;
  };
};
